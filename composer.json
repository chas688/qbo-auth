{
    "name": "charlesharmon/qbo-auth",
    "description": "QuickBooks Online OAuth 2.0 connection flow for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "quickbooks",
        "oauth2",
        "intuit"
    ],
    "authors": [
        {
            "name": "Charles Harmon",
            "email": "chas688@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.0",
        "quickbooks/v3-php-sdk": "^6.3"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "CharlesHarmon\\QboAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CharlesHarmon\\QboAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CharlesHarmon\\QboAuth\\QboAuthServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
